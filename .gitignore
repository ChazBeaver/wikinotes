# Never persist credentials, password-manager state, key containers, or shell history.
*.kdb
*.kdbx
*.keyx
**/.config/keepassxc/
**/.cache/keepassxc/
**/keepassxc.ini
**/KeePass.config.xml
**/.mono/keypairs/
**/.zsh_history
**/.bash_history

# Neovim fallback log, written to the working directory when its state dir is unwritable.
nvim.log
